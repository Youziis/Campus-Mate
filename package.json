    "element-plus": "^2.9.5",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pixi-live2d-display": "0.4.0",
    "pixi.js": "6.5.10",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^6.2.0"
